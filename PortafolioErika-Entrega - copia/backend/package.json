{
  "name": "portafolio-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Backend Node.js + Express + SQLite con autenticación, roles y CRUD de proyectos, habilidades y formación",
  "main": "src/server.js",
  "scripts": {
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:sin-build": "node --env-file-if-exists=.env src/server.js",
    "dev": "npm run build && node --env-file-if-exists=.env --watch src/server.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
